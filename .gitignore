# Editable PPT sources may remain local; adopted SVG/draw.io/PDF sources are tracked.
/paper/fig/*.pptx

# Compiler, editor and execution intermediates.
*.aux
*.bbl
*.blg
*.brf
*.log
*.out
*.xdv
*.fls
*.fdb_latexmk
*.synctex.gz
*.dtmp
