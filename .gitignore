compile-result.json

# Only the four formal manuscript PDFs belong in paper/build.
/paper/build/*
!/paper/build/en/
!/paper/build/zh/
!/paper/build/supp-en/
!/paper/build/supp-zh/
/paper/build/en/*
/paper/build/zh/*
/paper/build/supp-en/*
/paper/build/supp-zh/*
!/paper/build/en/main.pdf
!/paper/build/zh/main_zh.pdf
!/paper/build/supp-en/main.pdf
!/paper/build/supp-zh/main_zh.pdf
